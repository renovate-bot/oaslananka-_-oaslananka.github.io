[core]
	repositoryformatversion = 0
	filemode = false
	bare = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/oaslananka/oaslananka.github.io.git
	tagOpt = --no-tags
	fetch = +refs/*:refs/*
	mirror = true
[remote "org"]
	url = https://github.com/oaslananka-lab/oaslananka.github.io.git
	fetch = +refs/heads/*:refs/remotes/org/*
